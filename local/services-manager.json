{
  "prefix": "bfmarkets",
  "stop_timeout": 120,
  "restart_delay": 10,
  "services": {
    "reverb": {
      "command": [
        "reverb:start"
      ],
      "enabled": true
    },
    "betfair": {
      "command": [
        "betfair:listen"
      ],
      "enabled": true,
      "overrides": {
        "local": {
          "php_memory_limit": "2G"
        }
      }
    },
    "sports-api-pro": {
      "command": [
        "sports-api-pro:listen"
      ],
      "enabled": true
    },
    "queue-default": {
      "command": [
        "queue:work",
        "--queue=default",
        "--sleep=1",
        "--timeout=60",
        "--tries=3",
        "--max-time=3600"
      ],
      "enabled": true
    },
    "queue-sports-statistics": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=sports-statistics",
        "--sleep=1",
        "--timeout=45",
        "--tries=3",
        "--max-time=3600"
      ],
      "enabled": true
    },
    "queue-sports-images": {
      "command": [
        "queue:work",
        "--queue=sports-images",
        "--sleep=1",
        "--timeout=30",
        "--tries=3",
        "--max-time=3600"
      ],
      "enabled": true,
      "unit": "bfmarkets-queue-images.service"
    },
    "queue-realtime-football": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=realtime-football",
        "--sleep=0",
        "--timeout=15",
        "--tries=6",
        "--max-time=3600"
      ],
      "enabled": true,
      "unit": "bfmarkets-realtime@football.service"
    },
    "queue-realtime-cricket": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=realtime-cricket",
        "--sleep=0",
        "--timeout=15",
        "--tries=6",
        "--max-time=3600"
      ],
      "enabled": true,
      "unit": "bfmarkets-realtime@cricket.service"
    },
    "queue-realtime-icehockey": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=realtime-icehockey",
        "--sleep=0",
        "--timeout=15",
        "--tries=6",
        "--max-time=3600"
      ],
      "enabled": true,
      "unit": "bfmarkets-realtime@icehockey.service"
    },
    "queue-realtime-americanfootball": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=realtime-americanfootball",
        "--sleep=0",
        "--timeout=15",
        "--tries=6",
        "--max-time=3600"
      ],
      "enabled": true,
      "unit": "bfmarkets-realtime@americanfootball.service"
    },
    "queue-realtime-baseball": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=realtime-baseball",
        "--sleep=0",
        "--timeout=15",
        "--tries=6",
        "--max-time=3600"
      ],
      "enabled": true,
      "unit": "bfmarkets-realtime@baseball.service"
    },
    "queue-realtime-basketball": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=realtime-basketball",
        "--sleep=0",
        "--timeout=15",
        "--tries=6",
        "--max-time=3600"
      ],
      "enabled": true,
      "unit": "bfmarkets-realtime@basketball.service"
    },
    "queue-realtime-tennis": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=realtime-tennis",
        "--sleep=0",
        "--timeout=15",
        "--tries=6",
        "--max-time=3600"
      ],
      "enabled": true,
      "unit": "bfmarkets-realtime@tennis.service"
    },
    "queue-realtime-greyhounds": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=realtime-greyhounds",
        "--sleep=0",
        "--timeout=15",
        "--tries=6",
        "--max-time=3600"
      ],
      "enabled": true,
      "unit": "bfmarkets-realtime@greyhounds.service"
    },
    "queue-realtime-horseracing": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=realtime-horseracing",
        "--sleep=0",
        "--timeout=15",
        "--tries=6",
        "--max-time=3600"
      ],
      "enabled": true,
      "unit": "bfmarkets-realtime@horseracing.service"
    },
    "pinnodds": {
      "command": [
        "pinnodds:listen"
      ],
      "enabled": true
    },
    "scheduler": {
      "command": [
        "schedule:work"
      ],
      "enabled": true,
      "environments": [
        "local",
        "production"
      ],
      "unit": "bfmarkets-scheduler.service"
    },
    "telegram-bot": {
      "command": [
        "telegram:listen"
      ],
      "enabled": false,
      "overrides": {
        "local": {
          "enabled": true
        }
      }
    },
    "telegram-source": {
      "command": [
        "telegram:listen",
        "--source"
      ],
      "enabled": false
    },
    "queue-sports-prematch-statistics": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=sports-prematch-statistics",
        "--sleep=1",
        "--timeout=45",
        "--tries=3",
        "--max-time=3600"
      ],
      "workers": 2,
      "enabled": true
    },
    "queue-sports-recovery": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=sports-recovery",
        "--sleep=1",
        "--timeout=60",
        "--tries=3",
        "--max-time=3600"
      ],
      "enabled": true
    },
    "queue-sports-timeline": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=sports-timeline",
        "--sleep=1",
        "--timeout=60",
        "--tries=3",
        "--max-time=3600"
      ],
      "enabled": true
    },
    "queue-alerts": {
      "command": [
        "queue:work",
        "--queue=alerts",
        "--sleep=1",
        "--timeout=60",
        "--tries=3",
        "--max-time=3600"
      ],
      "enabled": true
    },
    "queue-sports-sync-live": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=sports-sync-live",
        "--sleep=1",
        "--timeout=60",
        "--tries=3",
        "--max-time=3600"
      ],
      "enabled": true
    },
    "queue-sports-sync-prematch": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=sports-sync-prematch",
        "--sleep=1",
        "--timeout=60",
        "--tries=3",
        "--max-time=3600"
      ],
      "enabled": true,
      "overrides": {
        "local": {
          "php_memory_limit": "2G"
        }
      }
    },
    "queue-legacy-sports-statistics": {
      "command": [
        "queue:work",
        "database",
        "--queue=sports-statistics",
        "--sleep=3",
        "--timeout=45",
        "--tries=3",
        "--max-time=3600"
      ],
      "enabled": true
    },
    "queue-alerts-platform": {
      "command": [
        "queue:work",
        "--queue=alerts-platform",
        "--sleep=1",
        "--timeout=60",
        "--tries=3",
        "--max-time=3600"
      ],
      "enabled": true
    },
    "queue-alerts-telegram": {
      "command": [
        "queue:work",
        "--queue=alerts-ltd,alerts-telegram",
        "--sleep=1",
        "--timeout=60",
        "--tries=3",
        "--max-time=3600"
      ],
      "enabled": true
    }
  },
  "overrides": {
    "local": {
      "prefix": "bfmarkets2508",
      "php_memory_limit": "2G"
    }
  }
}
