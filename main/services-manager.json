{
  "prefix": "bfmarkets-production",
  "stop_timeout": 120,
  "restart_delay": 10,
  "services": {
    "reverb": {
      "command": [
        "reverb:start"
      ],
      "enabled": true
    },
    "betfair": {
      "command": [
        "betfair:listen"
      ],
      "enabled": true
    },
    "sports-api-pro": {
      "command": [
        "sports-api-pro:listen"
      ],
      "enabled": true
    },
    "queue-default": {
      "command": [
        "queue:work",
        "--queue=default",
        "--sleep=1",
        "--timeout=60",
        "--tries=3",
        "--memory=-1",
        "--max-jobs=100",
        "--max-time=3600"
      ],
      "enabled": true,
      "restart_delay": 1
    },
    "queue-sports-statistics": {
      "command": [
        "queue:work",
        "sports-realtime",
        "--queue=sports-statistics,sports-prematch-statistics",
        "--sleep=1",
        "--timeout=45",
        "--tries=3",
        "--memory=-1",
        "--max-jobs=100",
        "--max-time=3600"
      ],
      "enabled": true,
      "restart_delay": 1
    },
    "queue-sports-images": {
