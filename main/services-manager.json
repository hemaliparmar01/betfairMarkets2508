        "queue:work",
        "--queue=sports-images",
        "--sleep=1",
        "--timeout=30",
        "--tries=3",
        "--memory=-1",
        "--max-jobs=200",
        "--max-time=3600"
      ],
      "enabled": true,
      "unit": "bfmarkets-production-queue-images.service",
      "restart_delay": 1
    },
    "queue-realtime-football": {
      "command": [
        "queue:work",
